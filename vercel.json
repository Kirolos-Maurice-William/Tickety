{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(cinema|concert|football|bus|train|plane|browse)", "destination": "/browse.html" },
    { "source": "/(event|ticket_detail)", "destination": "/event.html" },
